# Copy to .env for Docker Compose, or to apps/web/.env.local for `pnpm dev`.
# Every variable is optional; see docs/deployment.md.

# Web app: where uploads go (compose sets this to http://analysis:8000)
ANALYSIS_SERVICE_URL=http://localhost:8000

# Hugging Face token, if the Gemma license has to be accepted
HF_TOKEN=

# Gemma variant with audio input: google/gemma-4-E2B-it | google/gemma-4-E4B-it | google/gemma-4-12B-it
GEMMA_MODEL=google/gemma-4-E2B-it
# Empty: auto on GPU, cpu otherwise. cpu keeps the whole model in RAM
GEMMA_DEVICE_MAP=
# auto uses the checkpoint's bf16; float16 for GPUs without bf16 (e.g. T4)
GEMMA_DTYPE=auto

# Visual tokens per slide: 70 | 140 | 280 | 560 | 1120
SLIDE_TOKENS=560
# Pages of a deck that are analyzed
MAX_SLIDES=20
# Longest audio segment sent to Gemma, in seconds (at most 30)
SEGMENT_SECONDS=20
# The event's own expected topics as JSON, name to meaning; empty for Y Combinator's eight
PITCH_TOPICS=

# Make `next dev` poll for file changes (e.g. 1000) where file events are missed
NEXT_WATCH_POLL_MS=
